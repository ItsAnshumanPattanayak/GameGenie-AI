APP_NAME=GameGenie AI Backend
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RAW_DATASET_PATH=data/raw/games.json
PROCESSED_DATASET_PATH=data/processed/games.json
LOG_LEVEL=INFO
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
DATABASE_URL=sqlite:///data/gamegenie.db
AUTH_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PERSONALISATION_BASE_WEIGHT=0.80
PERSONALISATION_EXPLICIT_WEIGHT=0.10
PERSONALISATION_FAVOURITE_WEIGHT=0.04
PERSONALISATION_FEEDBACK_WEIGHT=0.04
PERSONALISATION_RECENT_SEARCH_WEIGHT=0.02
PERSONALISATION_TOTAL_CAP=0.20
PERSONALISATION_PROMPT_OVERLAP_FACTOR=0.25
